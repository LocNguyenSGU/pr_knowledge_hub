<div class="mb-8" data-controller="sync">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Pull Requests</h1>
      <p class="text-gray-600">Browse and filter pull requests from your repository</p>
    </div>
    <div class="text-right">
      <button
        data-sync-target="button"
        data-url="<%= sync_pull_requests_path %>"
        data-method="POST"
        data-action="click->sync#trigger"
        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        <span data-sync-target="spinner" class="hidden inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-2"></span>
        Sync Now
      </button>
      <div data-sync-target="status"></div>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow p-6 mb-6">
  <%= form_with url: pull_requests_path, method: :get, class: "flex flex-wrap gap-4", data: { controller: "filter", action: "submit->filter#submit" } do |f| %>
    <div class="flex-1 min-w-[200px]">
      <%= f.label :state, "State", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :state,
          options_for_select([ [ "All States", "" ] ] + @states.map { |s| [ s.titleize, s ] }, params[:state]),
          {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
          data: { action: "change->filter#change" } %>
    </div>

    <div class="flex-1 min-w-[200px]">
      <%= f.label :author, "Author", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :author,
          options_for_select([ [ "All Authors", "" ] ] + @authors.map { |a| [ a, a ] }, params[:author]),
          {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
          data: { action: "change->filter#change" } %>
    </div>

    <div class="flex-1 min-w-[200px]">
      <%= f.label :sort, "Sort By", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :sort,
          options_for_select([
            [ "Created Date", "github_created_at" ],
            [ "PR Number", "number" ],
            [ "Title", "title" ],
            [ "State", "state" ]
          ], params[:sort]),
          {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
          data: { action: "change->filter#change" } %>
    </div>

    <div class="flex items-end gap-2">
      <%= f.submit "Apply Filters", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
      <%= link_to "Clear", pull_requests_path, class: "px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors" %>
    </div>
  <% end %>
</div>

<!-- Pull Requests List -->
<div class="bg-white rounded-lg shadow">
  <% if @pull_requests.any? %>
    <div class="divide-y divide-gray-200">
      <% @pull_requests.each do |pr| %>
        <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
          <%= link_to pull_request_path(pr), class: "block" do %>
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <span class="text-lg font-semibold text-blue-600 hover:text-blue-700">#<%= pr.number %></span>
                  <h3 class="text-lg font-medium text-gray-900 line-clamp-2"><%= pr.title %></h3>
                </div>

                <% if pr.body.present? %>
                  <p class="text-sm text-gray-600 line-clamp-2 mb-3"><%= truncate(pr.body, length: 200) %></p>
                <% end %>

                <div class="flex items-center space-x-4 text-sm text-gray-500">
                  <div class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span><%= pr.author_name %></span>
                  </div>

                  <span>•</span>

                  <div class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span><%= pr.github_created_at ? "#{time_ago_in_words(pr.github_created_at)} ago" : "Unknown date" %></span>
                  </div>

                  <span>•</span>

                  <div class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span><%= pr.comments.count %> comments</span>
                  </div>

                  <% if pr.additions || pr.deletions %>
                    <span>•</span>
                    <div class="flex items-center space-x-2">
                      <span class="text-green-600">+<%= pr.additions || 0 %></span>
                      <span class="text-red-600">-<%= pr.deletions || 0 %></span>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="flex-shrink-0 ml-4">
                <span class="px-3 py-1 text-sm font-medium rounded-full <%=
                  case pr.state
                  when "open" then "bg-green-100 text-green-800"
                  when "merged" then "bg-purple-100 text-purple-800"
                  when "closed" then "bg-gray-100 text-gray-800"
                  else "bg-gray-100 text-gray-800"
                  end
                                                                        %>">
                  <%= pr.state&.titleize || "Unknown" %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @pull_requests %>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center text-gray-500">
      <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <p class="text-lg font-medium mb-2">No pull requests found</p>
      <p class="text-sm">Try adjusting your filters or sync PRs from GitHub.</p>
    </div>
  <% end %>
</div>
