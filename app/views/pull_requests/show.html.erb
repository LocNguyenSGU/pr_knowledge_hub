<div class="mb-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        PR #<%= @pull_request.number %>
      </h1>
      <h2 class="text-xl text-gray-700"><%= @pull_request.title %></h2>
    </div>
    <%= link_to "← Back to PRs", pull_requests_path, class: "text-blue-600 hover:text-blue-700" %>
  </div>
</div>

<!-- PR Details Card -->
<div class="bg-white rounded-lg shadow mb-6">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <span class="px-3 py-1 text-sm font-medium rounded-full <%=
          case @pull_request.state
          when "open" then "bg-green-100 text-green-800"
          when "merged" then "bg-purple-100 text-purple-800"
          when "closed" then "bg-gray-100 text-gray-800"
          else "bg-gray-100 text-gray-800"
          end
                                                                %>">
          <%= @pull_request.state&.titleize || "Unknown" %>
        </span>

        <div class="text-sm text-gray-600">
          <span class="font-medium"><%= @pull_request.author_name %></span>
          opened this PR <%= @pull_request.github_created_at ? "#{time_ago_in_words(@pull_request.github_created_at)} ago" : "Unknown date" %>
        </div>
      </div>

      <% if @pull_request.repository_url %>
        <%= link_to "View on GitHub →", @pull_request.repository_url, target: "_blank", class: "text-blue-600 hover:text-blue-700 text-sm font-medium" %>
      <% end %>
    </div>
  </div>

  <div class="px-6 py-4">
    <% if @pull_request.body.present? %>
      <div class="prose max-w-none">
        <%= simple_format(@pull_request.body) %>
      </div>
    <% else %>
      <p class="text-gray-500 italic">No description provided</p>
    <% end %>
  </div>

  <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex items-center space-x-6 text-sm">
    <div class="flex items-center space-x-2">
      <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span class="font-medium text-gray-700"><%= @comment_stats[:total] %> comments</span>
      <% if @comment_stats[:by_reviewers] > 0 %>
        <span class="text-gray-500">(<%= @comment_stats[:by_reviewers] %> from reviewers)</span>
      <% end %>
    </div>

    <% if @pull_request.additions || @pull_request.deletions %>
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <span class="text-green-600 font-medium">+<%= @pull_request.additions || 0 %></span>
        <span class="text-red-600 font-medium">-<%= @pull_request.deletions || 0 %></span>
      </div>
    <% end %>

    <% if @comment_stats[:analyzed] > 0 %>
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
        <span class="text-gray-700"><%= @comment_stats[:analyzed] %> AI-analyzed</span>
      </div>
    <% end %>
  </div>
</div>

<!-- Comments Section -->
<div class="bg-white rounded-lg shadow" data-controller="collapsible" data-collapsible-open-value="true">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">Comments & Reviews</h3>
      <button type="button" data-action="click->collapsible#toggle" class="text-gray-400 hover:text-gray-600">
        <svg data-collapsible-target="icon" class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>
  </div>

  <div data-collapsible-target="content">
  <% if @comments.any? %>
    <div class="divide-y divide-gray-200">
      <% @comments.each do |comment| %>
        <div class="px-6 py-4">
          <div class="flex items-start space-x-3">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                <span class="text-blue-600 font-medium text-sm"><%= comment.author_name&.first&.upcase || "?" %></span>
              </div>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center space-x-2 mb-1">
                <span class="font-medium text-gray-900"><%= comment.author_name %></span>
                <span class="px-2 py-0.5 text-xs font-medium rounded-full <%=
                  case comment.author_role
                  when "reviewer" then "bg-blue-100 text-blue-800"
                  when "author" then "bg-green-100 text-green-800"
                  when "contributor" then "bg-purple-100 text-purple-800"
                  else "bg-gray-100 text-gray-800"
                  end
                                                                          %>">
                  <%= comment.author_role&.titleize || "Unknown" %>
                </span>
                <span class="text-sm text-gray-500">
                  <%= comment.github_created_at ? "#{time_ago_in_words(comment.github_created_at)} ago" : "Unknown date" %>
                </span>
              </div>

              <div class="prose max-w-none text-sm text-gray-700 mb-3">
                <%= simple_format(comment.body) %>
              </div>

              <% if comment.tags.any? %>
                <div class="flex flex-wrap gap-2">
                  <% comment.tags.each do |tag| %>
                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700">
                      <%= tag.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center text-gray-500">
      <p>No comments yet on this pull request.</p>
    </div>
  <% end %>
</div>
  </div>

<!-- Related Insights -->
<% if @related_insights.any? %>
  <div class="mt-6 bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Related Insights</h3>
    </div>
    <div class="divide-y divide-gray-200">
      <% @related_insights.each do |insight| %>
        <%= link_to insight_path(insight), class: "block px-6 py-4 hover:bg-gray-50 transition-colors" do %>
          <div class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-purple-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            <div>
              <p class="text-sm font-medium text-gray-900"><%= insight.title %></p>
              <p class="text-xs text-gray-500 mt-1"><%= insight.insight_type&.titleize %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
