<div class="mb-8" data-controller="sync">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">AI Insights</h1>
      <p class="text-gray-600">Patterns, lessons, and recommendations from code reviews</p>
    </div>
    <div class="text-right">
      <!-- Status message above button -->
      <div data-sync-target="status" class="mb-2 min-h-[1.5rem]"></div>
      
      <button
        data-sync-target="button"
        data-url="<%= sync_analyze_path %>"
        data-method="POST"
        data-action="click->sync#trigger"
        class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">
        <span data-sync-target="spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
        <span data-sync-target="buttonText">Analyze & Generate Insights</span>
      </button>
    </div>
  </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-sm font-medium text-gray-600">Total Insights</h3>
      <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
      </svg>
    </div>
    <p class="text-3xl font-bold text-gray-900"><%= @stats[:total] %></p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-sm font-medium text-gray-600">Patterns</h3>
      <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z" />
      </svg>
    </div>
    <p class="text-3xl font-bold text-gray-900"><%= @stats[:patterns] %></p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-sm font-medium text-gray-600">Recommendations</h3>
      <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <p class="text-3xl font-bold text-gray-900"><%= @stats[:recommendations] %></p>
  </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow p-6 mb-6">
  <%= form_with url: insights_path, method: :get, class: "flex gap-4", data: { controller: "filter", action: "submit->filter#submit" } do |f| %>
    <div class="flex-1">
      <%= f.label :type, "Filter by Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :type,
          options_for_select([
            [ "All Types", "" ],
            [ "Patterns", "pattern" ],
            [ "Lessons", "lesson" ],
            [ "Recommendations", "recommendation" ]
          ], params[:type]),
          {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent",
          data: { action: "change->filter#change" } %>
    </div>

    <div class="flex items-end gap-2">
      <%= f.submit "Apply", class: "px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors cursor-pointer" %>
      <%= link_to "Clear", insights_path, class: "px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors" %>
    </div>
  <% end %>
</div>

<!-- Insights List -->
<div class="space-y-6">
  <% if @insights.any? %>
    <% @insights.each do |insight| %>
      <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow">
        <%= link_to insight_path(insight), class: "block p-6" do %>
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center space-x-2">
              <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span class="px-3 py-1 text-xs font-medium rounded-full <%=
                case insight.insight_type
                when "pattern" then "bg-blue-100 text-blue-800"
                when "lesson" then "bg-orange-100 text-orange-800"
                when "recommendation" then "bg-green-100 text-green-800"
                else "bg-gray-100 text-gray-800"
                end
                                                                      %>">
                <%= insight.insight_type&.titleize || "Insight" %>
              </span>
            </div>
            <span class="text-sm text-gray-500"><%= time_ago_in_words(insight.created_at) %> ago</span>
          </div>

          <h3 class="text-xl font-semibold text-gray-900 mb-3"><%= insight.title %></h3>

          <div class="prose max-w-none text-gray-700">
            <%= truncate(insight.content, length: 300) %>
          </div>

          <div class="mt-4 flex items-center justify-between text-sm text-gray-500">
            <div class="flex items-center space-x-4">
              <% if insight.metadata['related_comment_ids']&.any? %>
                <span><%= insight.metadata["related_comment_ids"].size %> related comments</span>
              <% end %>
              <% if insight.metadata['tag'] %>
                <span class="px-2 py-1 bg-gray-100 rounded text-xs"><%= insight.metadata["tag"] %></span>
              <% end %>
            </div>
            <span class="text-purple-600 hover:text-purple-700 font-medium">Read more →</span>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Pagination -->
    <div class="flex justify-center">
      <%= paginate @insights %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow px-6 py-12 text-center text-gray-500">
      <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
      </svg>
      <p class="text-lg font-medium mb-2">No insights generated yet</p>
      <p class="text-sm mb-4">Insights are automatically generated from analyzed comments.</p>
      <p class="text-sm">
        Run <code class="bg-gray-100 px-2 py-1 rounded">rails ai:insights</code> to generate insights.
      </p>
    </div>
  <% end %>
</div>
