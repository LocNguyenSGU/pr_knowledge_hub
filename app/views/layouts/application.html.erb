<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "PR Knowledge Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-visit-control" content="reload">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-8">
            <%= link_to root_path, class: "flex items-center space-x-2" do %>
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="font-bold text-xl text-gray-900">PR Knowledge Hub</span>
            <% end %>

            <div class="hidden md:flex space-x-4">
              <%= link_to "Dashboard", root_path, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium #{current_page?(root_path) ? 'bg-blue-50 text-blue-600' : ''}" %>
              <%= link_to "Pull Requests", pull_requests_path, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium #{current_page?(pull_requests_path) ? 'bg-blue-50 text-blue-600' : ''}" %>
              <%= link_to "Insights", insights_path, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium #{current_page?(insights_path) ? 'bg-blue-50 text-blue-600' : ''}" %>
              <%= link_to "Search", search_path, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium #{current_page?(search_path) ? 'bg-blue-50 text-blue-600' : ''}" %>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <%= form_with url: search_path, method: :get, class: "hidden md:block" do |f| %>
              <div class="relative">
                <%= f.text_field :q,
                    value: params[:q],
                    placeholder: "Search comments, PRs...",
                    class: "w-64 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                <button type="submit" class="absolute right-2 top-2 text-gray-400 hover:text-gray-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </button>
              </div>
            <% end %>

            <% if user_signed_in? %>
              <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-700">
                  <%= current_user.email %>
                </span>
                <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
                    class: "px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg text-sm font-medium transition-colors" %>
              </div>
            <% else %>
              <%= link_to "Sign In", new_user_session_path,
                  class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
      <% if flash[:notice] %>
        <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-white border-t border-gray-200 mt-16">
      <div class="container mx-auto px-4 py-6">
        <div class="flex items-center justify-between text-sm text-gray-600">
          <div>
            <span>PR Knowledge Hub - AI-Powered Code Review Learning</span>
          </div>
          <div class="flex items-center space-x-4">
            <%= link_to "Sidekiq Dashboard", sidekiq_web_path, class: "hover:text-blue-600", target: "_blank" %>
            <% if ENV['GITHUB_REPOSITORY'] %>
              <span>•</span>
              <%= link_to "GitHub", "https://github.com/#{ENV['GITHUB_REPOSITORY']}", class: "hover:text-blue-600", target: "_blank" %>
            <% end %>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
