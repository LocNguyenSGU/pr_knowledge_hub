<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Search</h1>
  <p class="text-gray-600">Find comments, pull requests, and insights</p>
</div>

<!-- Search Form -->
<div class="bg-white rounded-lg shadow p-6 mb-6">
  <%= form_with url: search_path, method: :get, class: "space-y-4", data: { controller: "search", turbo_frame: "search_results" } do |f| %>
    <div>
      <%= f.label :q, "Search Query", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <div class="relative">
        <%= f.text_field :q,
            value: @query,
            placeholder: "Search for keywords...",
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-lg",
            autofocus: true,
            data: { search_target: "input", action: "input->search#search" } %>
        <button type="submit" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>
    </div>

    <div class="flex items-center space-x-4">
      <label class="flex items-center space-x-2">
        <%= f.radio_button :scope, "comments", checked: @scope == "comments", class: "text-blue-600 focus:ring-blue-500" %>
        <span class="text-sm text-gray-700">Comments</span>
      </label>
      <label class="flex items-center space-x-2">
        <%= f.radio_button :scope, "pull_requests", checked: @scope == "pull_requests", class: "text-blue-600 focus:ring-blue-500" %>
        <span class="text-sm text-gray-700">Pull Requests</span>
      </label>
      <label class="flex items-center space-x-2">
        <%= f.radio_button :scope, "insights", checked: @scope == "insights", class: "text-blue-600 focus:ring-blue-500" %>
        <span class="text-sm text-gray-700">Insights</span>
      </label>
    </div>

    <%= f.submit "Search", class: "px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer font-medium" %>
  <% end %>
</div>

<!-- Results -->
<%= turbo_frame_tag "search_results" do %>
  <% if @query.present? %>
    <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">
        <%= @result_count %> result<%= @result_count != 1 ? "s" : "" %> for "<%= @query %>" in <%= @scope.titleize %>
      </h2>
    </div>

    <% if @results.any? %>
      <div class="divide-y divide-gray-200">
        <% case @scope %>
        <% when 'comments' %>
          <% @results.each do |comment| %>
            <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
              <%= link_to pull_request_path(comment.pull_request), class: "block" do %>
                <div class="flex items-start space-x-3">
                  <div class="flex-shrink-0">
                    <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                      <span class="text-blue-600 font-medium text-sm"><%= comment.author_name&.first&.upcase || "?" %></span>
                    </div>
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center space-x-2 mb-1">
                      <span class="font-medium text-gray-900"><%= comment.author_name %></span>
                      <span class="text-sm text-gray-500">on PR #<%= comment.pull_request.number %></span>
                      <span class="text-sm text-gray-500">•</span>
                      <span class="text-sm text-gray-500"><%= comment.github_created_at ? "#{time_ago_in_words(comment.github_created_at)} ago" : "Unknown date" %></span>
                    </div>

                    <div class="text-sm text-gray-700 mb-2">
                      <%= highlight(comment.body, @query, highlighter: '<mark class="bg-yellow-200">\1</mark>') %>
                    </div>

                    <% if comment.tags.any? %>
                      <div class="flex flex-wrap gap-2">
                        <% comment.tags.each do |tag| %>
                          <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700">
                            <%= tag.name %>
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

        <% when 'pull_requests' %>
          <% @results.each do |pr| %>
            <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
              <%= link_to pull_request_path(pr), class: "block" do %>
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center space-x-3 mb-2">
                      <span class="text-lg font-semibold text-blue-600">#<%= pr.number %></span>
                      <h3 class="text-lg font-medium text-gray-900">
                        <%= highlight(pr.title, @query, highlighter: '<mark class="bg-yellow-200">\1</mark>') %>
                      </h3>
                    </div>

                    <% if pr.body.present? %>
                      <p class="text-sm text-gray-600 line-clamp-2">
                        <%= highlight(truncate(pr.body, length: 200), @query, highlighter: '<mark class="bg-yellow-200">\1</mark>') %>
                      </p>
                    <% end %>

                    <div class="flex items-center space-x-3 text-sm text-gray-500 mt-2">
                      <span><%= pr.author_name %></span>
                      <span>•</span>
                      <span><%= pr.github_created_at ? "#{time_ago_in_words(pr.github_created_at)} ago" : "Unknown date" %></span>
                    </div>
                  </div>

                  <span class="flex-shrink-0 ml-4 px-3 py-1 text-sm font-medium rounded-full <%=
                    case pr.state
                    when "open" then "bg-green-100 text-green-800"
                    when "merged" then "bg-purple-100 text-purple-800"
                    else "bg-gray-100 text-gray-800"
                    end
                                                                                             %>">
                    <%= pr.state&.titleize %>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>

        <% when 'insights' %>
          <% @results.each do |insight| %>
            <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
              <%= link_to insight_path(insight), class: "block" do %>
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-purple-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>

                  <div class="flex-1">
                    <div class="flex items-center space-x-2 mb-1">
                      <span class="px-2 py-1 text-xs font-medium rounded-full <%=
                        case insight.insight_type
                        when "pattern" then "bg-blue-100 text-blue-800"
                        when "lesson" then "bg-orange-100 text-orange-800"
                        when "recommendation" then "bg-green-100 text-green-800"
                        else "bg-gray-100 text-gray-800"
                        end
                                                                              %>">
                        <%= insight.insight_type&.titleize %>
                      </span>
                      <span class="text-sm text-gray-500"><%= time_ago_in_words(insight.created_at) %> ago</span>
                    </div>

                    <h3 class="text-lg font-medium text-gray-900 mb-2">
                      <%= highlight(insight.title, @query, highlighter: '<mark class="bg-yellow-200">\1</mark>') %>
                    </h3>

                    <p class="text-sm text-gray-700">
                      <%= highlight(truncate(insight.content, length: 300), @query, highlighter: '<mark class="bg-yellow-200">\1</mark>') %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Pagination -->
      <div class="px-6 py-4 border-t border-gray-200">
        <%= paginate @results %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <p class="text-lg font-medium mb-2">No results found</p>
        <p class="text-sm">Try different keywords or search in another category.</p>
      </div>
    <% end %>
  </div>
  <% else %>
    <div class="bg-white rounded-lg shadow px-6 py-12 text-center text-gray-500">
      <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="text-lg font-medium mb-2">Start searching</p>
      <p class="text-sm">Enter keywords to find relevant comments, PRs, or insights.</p>
    </div>
  <% end %>
<% end %>
