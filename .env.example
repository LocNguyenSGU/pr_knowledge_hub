# ============================================
# API Keys (Required)
# ============================================

# OpenAI API Key
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token
# Get it from: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_ACCESS_TOKEN=your_github_token_here

# GitHub Repository (format: owner/repo)
# Example: LocNguyenSGU/pr_knowledge_hub
GITHUB_REPOSITORY=your_username/your_repo

# ============================================
# Database (Optional - uses defaults if not set)
# ============================================

# PostgreSQL connection URL
# Example: postgres://username:password@localhost:5432/pr_knowledge_hub_development
# DATABASE_URL=postgres://localhost:5432/pr_knowledge_hub_development

# ============================================
# Redis (Optional - uses defaults if not set)
# ============================================

# Redis connection URL for Sidekiq
# Default: redis://localhost:6379/1
# REDIS_URL=redis://localhost:6379/1

# ============================================
# Server Configuration (Optional)
# ============================================

# Rails server port
# Default: 3000
# PORT=3000

# Number of Puma threads
# Default: 3
# RAILS_MAX_THREADS=3

# Number of Puma workers (production)
# WEB_CONCURRENCY=2

# Rails log level (production)
# Options: debug, info, warn, error, fatal
# Default: info
# RAILS_LOG_LEVEL=info

# ============================================
# Rails Environment
# ============================================

# Rails environment
# Options: development, test, production
# RAILS_ENV=development
